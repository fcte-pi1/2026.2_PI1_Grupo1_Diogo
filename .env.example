# Copie para .env (nunca versionado):  cp .env.example .env
# Valores abaixo são apenas para DESENVOLVIMENTO local.

# --- PostgreSQL (dono do banco: usado pelas migrações e pelo seed) ---
POSTGRES_DB=rato_borrachudo
POSTGRES_USER=rato
POSTGRES_PASSWORD=rato_dev

# --- Papel da aplicação (permissões restritas, ver arquitetura do backend §7.3) ---
# O nome do papel é fixo (rato_app) porque as migrações concedem permissões a ele.
DB_APP_PASSWORD=rato_app_dev

# --- Backend ---
PORT=8080
LOG_LEVEL=debug
JWT_SECRET=troque-esta-chave-em-producao

# --- Seed do ambiente padrão de testes (AMB, docs/software/backend/4_casos_de_teste.md) ---
SEED_DISPOSITIVO_TOKEN=T-VALIDO
SEED_OPERADOR_SENHA=op1-dev

# --- Portas expostas no host ---
DB_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173

# --- Hot reload: ative se as alterações não forem detectadas nos containers ---
CHOKIDAR_USEPOLLING=false
