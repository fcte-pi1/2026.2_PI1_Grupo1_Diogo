{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rato-borrachudo.local/protocolo/v1/estado.schema.json",
  "title": "estado",
  "description": "Estado de navegação do firmware (evento discreto, enviado a cada transição).",
  "$ref": "comum.schema.json#/$defs/envelope",
  "type": "object",
  "properties": {
    "v": true,
    "corrida": true,
    "seq": true,
    "t": true,
    "tipo": {
      "const": "estado"
    },
    "estado": {
      "enum": ["INICIALIZANDO", "AGUARDANDO", "MAPEANDO", "RESOLVENDO", "CONCLUIDO", "ERRO"]
    }
  },
  "required": ["estado"],
  "unevaluatedProperties": false
}
