{
  "name": "@rato-borrachudo/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend do Micromouse Rato Borrachudo: ingestão de telemetria, persistência, derivação e distribuição.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "migrate": "node-pg-migrate --migrations-dir migracoes --migration-file-language sql --database-url-var DATABASE_URL",
    "migrate:create": "node-pg-migrate create --migrations-dir migracoes --migration-file-language sql --migration-filename-format utc",
    "seed": "tsx scripts/seed.ts",
    "ponte": "tsx ponte/cli.ts",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:cobertura": "vitest run --project unit --coverage",
    "test:integracao": "vitest run --project integracao",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.3",
    "ajv": "8.20.0",
    "argon2": "0.45.1",
    "fastify": "5.12.5",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "serialport": "13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true,
    "@serialport/bindings-cpp@13.0.0": true
  }
}
