# Configuração comum a todos os alvos. O ESP-IDF aplica depois o arquivo do
# alvo escolhido no set-target: sdkconfig.defaults.esp32s3 (placa oficial) ou
# sdkconfig.defaults.esp32 (bancada com ESP-WROOM-32).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_FREERTOS_HZ=1000
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
